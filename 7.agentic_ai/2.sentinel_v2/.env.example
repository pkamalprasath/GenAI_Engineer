# SENTINEL v2 — Environment Configuration
# Copy this file to .env and fill in your values: cp .env.example .env
# NEVER commit .env to version control (secrets!)

# ── Ollama (Local LLM) ────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── LLM APIs ──────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys (OpenAI)
#          https://console.anthropic.com (Anthropic)
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Database ──────────────────────────────────────────────
# Local: postgresql://postgres:password@localhost/sentinel_db
# Supabase: postgresql://[user]:[pass]@[host]/[db] (recommended)
DATABASE_URL=postgresql://postgres:password@localhost/sentinel_db

# ── Redis (Background Jobs) ───────────────────────────────
# Local: redis://localhost:6379
# Cloud: redis://[:password]@[host]:[port]
REDIS_URL=redis://localhost:6379

# ── API Configuration ─────────────────────────────────────
SENTINEL_API_KEY=your-secure-random-key-here
RATE_LIMIT_PER_MINUTE=20

# ── Observability (Optional) ──────────────────────────────
# LangFuse: https://app.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=sentinel-v2

# ── Domain & Features ─────────────────────────────────────
ACTIVE_DOMAIN=finance
ENABLE_BIAS_DETECTION=true
ENABLE_PARALLEL_AGENTS=true
HITL_CONFIDENCE_THRESHOLD=0.85
MAX_INVESTIGATION_ITERATIONS=5

# ── Security ──────────────────────────────────────────────
PII_REDACTION_ENABLED=true

# ── Tenant Configuration ──────────────────────────────────
DEMO_TENANT_ID=bank-acme
