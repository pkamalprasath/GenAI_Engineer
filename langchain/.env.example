# ============================================================
# LangChain Mastery - Environment Variables Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your actual API keys below
#   3. NEVER commit the .env file to GitHub (it's in .gitignore)
# ============================================================

# --- OpenAI ---
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key-here"

# --- LangChain / LangSmith (for tracing & monitoring) ---
# Get from: https://smith.langchain.com/settings
LANGCHAIN_API_KEY="your-langchain-api-key-here"
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT="LangChain-Mastery"

# --- HuggingFace ---
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN="your-huggingface-token-here"

# --- Groq (fast LLM inference) ---
# Get from: https://console.groq.com/keys
GROQ_API_KEY="your-groq-api-key-here"

# --- Neo4j (Graph Database) ---
# Get from: https://console.neo4j.io/
NEO4J_URI="neo4j+s://your-instance.databases.neo4j.io"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="your-neo4j-password-here"

# --- AWS Bedrock (optional) ---
# Configure via: aws configure
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_DEFAULT_REGION="us-east-1"

# --- PineconeDB (optional, for hybrid search) ---
# Get from: https://app.pinecone.io/
PINECONE_API_KEY="your-pinecone-api-key-here"
PINECONE_ENV="your-pinecone-environment"

# --- Lamini (fine-tuning API) ---
# Get from: https://app.lamini.ai/account
LAMINI_API_KEY="your-lamini-api-key-here"

# --- AstraDB / DataStax (vector database) ---
# Get from: https://astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN="your-astra-db-token-here"
ASTRA_DB_ID="your-astra-database-id-here"
