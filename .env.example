# ═══════════════════════════════════════════════════════════════════════════════
# SLACK BOT ASSISTANT - Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your API credentials
# NEVER commit .env to version control - it contains sensitive credentials
#
# Quick Start: https://github.com/your-repo/QUICK_START.md
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# REQUIRED: Slack Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# 1. Go to https://api.slack.com/apps
# 2. Create a new app "From scratch"
# 3. Set up OAuth & Permissions to get Bot Token (xoxb-*)
# 4. Set up Socket Mode to get App Token (xapp-*)
# 5. Get Signing Secret from Basic Information
#
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# ═══════════════════════════════════════════════════════════════════════════════
# REQUIRED: AI Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Get your API key from https://console.anthropic.com/
# The bot uses Claude 3.5 Sonnet for conversations and summarization
#
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL: OpenAI Configuration (for embeddings)
# ═══════════════════════════════════════════════════════════════════════════════
# Get your API key from https://platform.openai.com/api-keys
# Only needed if you want OpenAI embeddings (ChromaDB uses local embeddings by default)
#
# OPENAI_API_KEY=sk-proj-your-openai-key-here

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL: GitHub Integration
# ═══════════════════════════════════════════════════════════════════════════════
# Enable GitHub issue creation from bot suggestions
# Create a Personal Access Token at https://github.com/settings/tokens
# Scopes needed: repo, issues
#
# GITHUB_TOKEN=ghp_your-github-token-here

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL: Notion Integration
# ═══════════════════════════════════════════════════════════════════════════════
# Enable Notion page creation and search
# Create an integration at https://www.notion.so/my-integrations
#
# NOTION_TOKEN=ntn_your-notion-token-here

# ═══════════════════════════════════════════════════════════════════════════════
# Database Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Development: SQLite (file-based, no setup needed)
DATABASE_URL=sqlite:///./memory_store/agent_state.db

# Production: PostgreSQL with pgvector
# DATABASE_URL=postgresql://user:password@localhost:5432/slack_bot

# ═══════════════════════════════════════════════════════════════════════════════
# Application Settings
# ═══════════════════════════════════════════════════════════════════════════════
# ENVIRONMENT: development (Socket Mode) or production (HTTP webhooks)
ENVIRONMENT=development

# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Port for HTTP server (only used in production mode)
PORT=3000

# ═══════════════════════════════════════════════════════════════════════════════
# RAG Configuration (Retrieval-Augmented Generation)
# ═══════════════════════════════════════════════════════════════════════════════
# ChromaDB persists indexed messages in this directory for semantic search
CHROMA_PERSIST_DIRECTORY=./memory_store/chroma_db

# How often to re-index channel messages (in seconds)
# Default: 7200 = 2 hours
RAG_INDEXING_FREQUENCY=7200

# Max messages to retrieve per channel during indexing
RAG_MESSAGE_LIMIT=200

# ═══════════════════════════════════════════════════════════════════════════════
# Security Settings
# ═══════════════════════════════════════════════════════════════════════════════
# Rate limits for reminders and API calls (per minute)
RATE_LIMIT_PER_USER=10
RATE_LIMIT_PER_CHANNEL=30

# Days before issuing token rotation reminder
TOKEN_ROTATION_DAYS=7

# ═══════════════════════════════════════════════════════════════════════════════
# Memory Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Local directory for memory store (reminders.json, conversation history)
MEMORY_STORE_PATH=./memory_store

# Cron schedule for memory distillation (cleanup old memories)
# Format: minute hour day month day_of_week
# 0 0 * * 0 = Every Sunday at midnight
MEMORY_DISTILLATION_CRON=0 0 * * 0
