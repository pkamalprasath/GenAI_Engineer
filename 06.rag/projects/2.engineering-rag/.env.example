




# Engineering RAG — Environment Configuration
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored.

# ── LLM API Keys (at least one required) ──────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_API_KEY disabled — credits exhausted until 2026-05-01, using OpenAI fallback
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ── LLM Model Selection ────────────────────────────────────────────────────
# TEXT_LLM_STRONG = main generation model (Claude Sonnet or GPT-4o)
# TEXT_LLM_FAST   = fast judge model (Claude Haiku or GPT-4o-mini)
TEXT_LLM_STRONG=claude-sonnet-4-6
TEXT_LLM_FAST=claude-haiku-4-5-20251001
TEXT_LLM=gpt-4o-mini
VISION_LLM=gpt-4o

# ── Embedding Model ────────────────────────────────────────────────────────
EMBED_MODEL=all-MiniLM-L6-v2

# ── PostgreSQL Database ────────────────────────────────────────────────────
POSTGRES_HOST=YOUR_SUPABASE_HOST.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_USER=postgres.YOUR_PROJECT_ID
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
POSTGRES_DB=postgres
POSTGRES_SSL=require
# For cloud providers (Neon, Supabase, Railway) uncomment:
# POSTGRES_SSL=require

# ── Retrieval Tuning ───────────────────────────────────────────────────────
TOP_K_PER_TYPE=8       # chunks retrieved per type (text/table/image)
FINAL_TOP_K=10         # final chunks after RRF merge
RRF_K=60               # RRF constant (higher = smaller rank gap)

# ── Generation Tuning ──────────────────────────────────────────────────────
MAX_ANSWER_TOKENS=1024
MAX_HYDE_TOKENS=256
MAX_CRAG_JUDGE_TOKENS=64
MAX_SELF_RAG_TOKENS=128
SELF_RAG_MAX_RETRIES=1

# ── CRAG Tuning ────────────────────────────────────────────────────────────
CRAG_IMAGE_PASSAGE_TOKENS=600   # chars sent to judge for image chunks
CRAG_TEXT_PASSAGE_TOKENS=400    # chars sent to judge for text/table chunks
CRAG_SCORE_RELEVANT=1.0
CRAG_SCORE_AMBIGUOUS=0.5
CRAG_SCORE_IRRELEVANT=0.0

# ── HyDE Tuning ────────────────────────────────────────────────────────────
HYDE_TEMPERATURE=0.3    # low = technical/factual; higher = more creative

# ── Query Decomposer Tuning ────────────────────────────────────────────────
DECOMP_MAX_SUBQUERIES=4     # max sub-questions for multihop queries
DECOMP_MIN_QUERY_LENGTH=10  # ignore sub-questions shorter than this

# ── Adaptive Router Tuning ─────────────────────────────────────────────────
ROUTER_CLASSIFY_MAX_TOKENS=5    # just needs "SIMPLE" or "COMPLEX"
ROUTER_ANSWER_MAX_TOKENS=512    # answer length for simple queries

# ── Chunking ───────────────────────────────────────────────────────────────
SEMANTIC_BREAKPOINT_TYPE=percentile
SEMANTIC_BREAKPOINT_THRESHOLD=95   # higher = fewer, larger chunks

# ── Feature Flags (set to false to disable) ───────────────────────────────
USE_HYDE=true                  # HyDE query expansion
USE_QUERY_DECOMPOSITION=true   # multihop query decomposition
USE_CRAG=true                  # CRAG chunk quality filtering
USE_SELF_RAG=true              # Self-RAG answer grounding check
PII_REDACTION_ENABLED=false    # PII redaction (requires Presidio install)

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Observability (Langfuse Cloud) ────────────────────────────────────────
# Sign up at https://langfuse.com → Settings → API Keys
LANGFUSE_SECRET_KEY="sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
LANGFUSE_PUBLIC_KEY="pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# ── Observability (Grafana Cloud Loki — log search & dashboards) ──────────
# Sign up free at https://grafana.com → Grafana Cloud (free plan, 50 GB/month)
# Steps to get credentials:
#   1. grafana.com → your stack → Connections → Add new connection → Loki
#   2. Or: grafana.com → your stack → Loki → "Send Logs" button
#   3. Copy the Push URL, User (numeric), and generate an API key
#
# Leave blank to disable (app works fine without it)
GRAFANA_LOKI_URL=https://logs-prod-YOUR-REGION.grafana.net/loki/api/v1/push
GRAFANA_USER=123456
GRAFANA_API_KEY=your-grafana-api-key-here
APP_ENV=dev
